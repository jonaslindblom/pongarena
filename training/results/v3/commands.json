{
  "rules": "pong-v3",
  "implementation_checkpoint": "0a03e1f",
  "training_concurrency": 3,
  "torch_threads_per_run": 1,
  "training": [
    {
      "seed": 7,
      "command": ".venv/bin/python training/scripts/train.py --out training/runs/v3-seed7 --seed 7 --dagger-rounds 10 --updates 250 --eval-every 25",
