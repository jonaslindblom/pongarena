    },
    {
      "seed": 17,
      "command": ".venv/bin/python training/scripts/train.py --out training/runs/v3-seed17 --seed 17 --dagger-rounds 10 --updates 250 --eval-every 25",
      "console_log": "seed17/console.log"
    },
    {
      "seed": 29,
      "command": ".venv/bin/python training/scripts/train.py --out training/runs/v3-seed29 --seed 29 --dagger-rounds 10 --updates 250 --eval-every 25",
      "console_log": "seed29/console.log"
    }
  ],
  "release": ".venv/bin/python training/scripts/release.py",
  "export_verification": ".venv/bin/python training/scripts/verify_export.py",
  "typescript_replay_verification": "node --import tsx training/scripts/check_replays.ts",
  "evaluation_note": "Release selects by validation only, then evaluates the exported v3 actors and original v2 actors under identical v3 rules and final-test serves."
